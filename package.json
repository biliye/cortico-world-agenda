{
  "name": "cortico-world-agenda",
  "version": "0.2.2",
  "type": "module",
  "author": {
    "name": "筆離嘢"
  },
  "description": "Cortico World: 日程与便签 —— 到点把一条提示投给她并当场叫醒(循环闹钟 / 定时 / 一次性,错过只补一次),外加一册两人共写、开机整册交给她的便签。控制台有两个页签。要求 Cortico 0.2.0 及以上。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/biliye/cortico-world-agenda.git"
  },
  "homepage": "https://github.com/biliye/cortico-world-agenda#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "schedule",
    "reminder",
    "cron",
    "notes",
    "notepad"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "日程与便签",
    "icon": "assets/icon.svg",
    "tags": [
      "memory",
      "companion"
    ],
    "locales": {
      "en": {
        "displayName": "Schedule & Notes",
        "description": "Cortico World: a shared schedule that wakes the bot with a prompt at its due minute (repeat interval, cron or one-shot; missed periods are caught up once), plus a shared notepad delivered in full whenever the World starts. Two console tabs. Requires Cortico 0.2.0 or later."
      }
    },
    "webUiClient": "dist/webui.js",
    "describe": "describe.json"
  },
  "files": [
    "src",
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "describe.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "build:webui": "esbuild src/webui/client.ts --bundle --format=esm --outfile=dist/webui.js --tsconfig=tsconfig.web.json",
    "prepublishOnly": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
