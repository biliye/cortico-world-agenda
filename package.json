{
  "name": "cortico-world-agenda",
  "version": "0.2.0",
  "type": "module",
  "description": "Cortico World: a shared schedule that pushes prompt events at their due minute, plus a shared notepad delivered in full whenever the World starts",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "webUiClient": "dist/webui.js",
    "describe": "describe.json"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "describe.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "build:webui": "esbuild src/webui/client.ts --bundle --format=esm --outfile=dist/webui.js --tsconfig=tsconfig.web.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
