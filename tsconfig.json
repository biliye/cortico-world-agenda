{
  // Node 侧代码用这份(不带 DOM);面板源码 src/console 由 tsconfig.web.json 单独查。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    // 开发期把 `cortico/*` 指到工作区里的框架 checkout;装进宿主运行时不靠它,
    // 那时由框架 `src/extensions/runtime.ts` 的模块钩子解析。
    "paths": {
      "cortico/*": ["../../cortico/src/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/console"]
}
